# Google Gemini API key — https://aistudio.google.com/apikey
# Without this the chat assistant returns a 503.
GEMINI_API_KEY=

# Optional: override the primary chat model
# GEMINI_MODEL=gemini-3-flash-preview

# Optional: comma-separated fallback chain, tried in order
# GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash,gemini-3.1-flash-lite

# Optional: local server port (defaults to 3000)
# PORT=3000
